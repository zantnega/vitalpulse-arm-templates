{
	"$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"virtualMachines_test_vm_01_name": {
			"defaultValue": "test-vm-01",
			"type": "String"
		},
		"disks_test_vm_01_OsDisk_1_148662bbd687454d8b0078dfb7ea1243_externalid": {
			"defaultValue": "/subscriptions/7fc1e387-571e-4acc-8725-e2c0d8ac3825/resourceGroups/rg-payg-test-vm/providers/Microsoft.Compute/disks/test-vm-01_OsDisk_1_148662bbd687454d8b0078dfb7ea1243",
			"type": "String"
		},
		"disks_test_vm_01_DataDisk_0_externalid": {
			"defaultValue": "/subscriptions/7fc1e387-571e-4acc-8725-e2c0d8ac3825/resourceGroups/rg-payg-test-vm/providers/Microsoft.Compute/disks/test-vm-01_DataDisk_0",
			"type": "String"
		},
		"networkInterfaces_test_vm_017_externalid": {
			"defaultValue": "/subscriptions/7fc1e387-571e-4acc-8725-e2c0d8ac3825/resourceGroups/rg-payg-test-vm/providers/Microsoft.Network/networkInterfaces/test-vm-017",
			"type": "String"
		}
	},
	"variables": {},
	"resources": [
		{
			"type": "Microsoft.Compute/virtualMachines",
			"apiVersion": "2024-07-01",
